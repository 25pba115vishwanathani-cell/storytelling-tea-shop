<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Our Founders | Story Telling Tea Shop</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #fffaf2;
    color: #3b2416;
    line-height: 1.6;
}

/* HEADER */
header {
    background: #4b2e1f;
    color: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.logo {
    font-size: 25px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 8px;
    font-weight: bold;
}

nav a:hover {
    color: #d99b55;
}

/* PAGE HERO */
.hero {
    background: linear-gradient(
        rgba(75,46,31,0.88),
        rgba(75,46,31,0.88)
    );
    color: white;
    text-align: center;
    padding: 65px 20px;
}

.hero h1 {
    font-size: 50px;
    margin-bottom: 10px;
}

.hero p {
    font-size: 20px;
}

/* FOUNDERS SECTION */
section {
    padding: 60px 8%;
    text-align: center;
}

section h2 {
    color: #4b2e1f;
    font-size: 35px;
    margin-bottom: 15px;
}

.section-intro {
    max-width: 750px;
    margin: 0 auto 35px;
    font-size: 18px;
    color: #6b4428;
}

/* ONE FOUNDERS IMAGE */
.founders-image-container {
    max-width: 1500px;
    margin: 0 auto;
    background: white;
    padding: 15px;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
}

.founders-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
}

/* STORY */
.founder-story {
    max-width: 900px;
    margin: 45px auto 0;
    background: white;
    padding: 35px;
    border-radius: 18px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.10);
}

.founder-story h3 {
    color: #4b2e1f;
    font-size: 27px;
    margin-bottom: 15px;
}

.founder-story p {
    font-size: 18px;
    margin-bottom: 15px;
}

/* QUOTE */
.quote {
    max-width: 850px;
    margin: 40px auto 0;
    padding: 25px;
    border-left: 5px solid #d99b55;
    background: #f5eadb;
    font-size: 22px;
    font-style: italic;
    color: #4b2e1f;
}

/* FOOTER */
footer {
    background: #2b1a12;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 20px;
}

/* MOBILE */
@media (max-width: 700px) {

    header {
        justify-content: center;
        text-align: center;
        gap: 15px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero p {
        font-size: 17px;
    }

    section {
        padding: 40px 5%;
    }

    section h2 {
        font-size: 30px;
    }

    .founders-image-container {
        padding: 8px;
    }

    .founder-story {
        padding: 25px 20px;
    }

    .quote {
        font-size: 18px;
    }
}
</style>
</head>

<body>

<!-- HEADER -->
<header>

    <div class="logo">
        🍵 Story Telling Tea Shop
    </div>

    <nav>
        <a href="index.html">Home</a>
        <a href="about.html">About</a>
        <a href="founders.html">Founders</a>
        <a href="experience.html">Experience</a>
        <a href="menu.html">Menu</a>
        <a href="contact.html">Contact</a>
    </nav>

</header>


<!-- PAGE HERO -->
<section class="hero">

    <h1>Our Founders</h1>

    <p>
        The minds behind Story Telling Tea Shop
    </p>

</section>


<!-- FOUNDERS -->
<section>

    <h2>Meet Our Three Founders</h2>

    <p class="section-intro">
        Three friends, one idea and one shared vision —
        to create a tea shop where every cup brings people
        together and every story matters.
    </p>


    <!-- ONE IMAGE CONTAINING ALL THREE FOUNDERS -->
    <div class="founders-image-container">

        <img
            src="founders.png"
            alt="Sanjeev, Vishwanathan and Javan - Founders of Story Telling Tea Shop"
            class="founders-image"
        >

    </div>


    <!-- STORY -->
    <div class="founder-story">

        <h3>Our Founding Story</h3>

        <p>
            Story Telling Tea Shop was founded by
            <strong>Sanjeev Kumar, Vishwanathan I and Javansker J</strong>.
        </p>

        <p>
            Our idea was simple — create a tea shop that is
            more than just a place to drink tea.
        </p>

        <p>
            We wanted to create a comfortable space where people
            can enjoy freshly prepared tea, meet friends,
            have meaningful conversations, read, write and
            share their stories.
        </p>

    </div>


    <!-- QUOTE -->
    <div class="quote">

        “Tea is more than a drink,
        it’s a connection of hearts and stories.”

    </div>

</section>


<!-- FOOTER -->
<footer>

    <p>
        © 2025 Story Telling Tea Shop - Trichy
    </p>

    <p>
        Every Cup Has a Story ☕
    </p>

</footer>

</body>
</html>
